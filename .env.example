# Local Codebase AI — Environment Configuration
# Copy this file to .env and fill in the values.

# --- Qdrant (vector database) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=code_chunks

# --- Ollama (local embeddings — always required regardless of chat provider) ---
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
VECTOR_SIZE=768

# --- Ollama context window (only used for local Ollama chat) ---
# Lower = faster on CPU. 8192 is a good balance.
OLLAMA_NUM_CTX=8192

# =============================================================================
# CHAT PROVIDER — pick ONE of the options below
# Embeddings always stay local (Ollama). Only chat/LLM goes to the cloud.
# =============================================================================

# --- Option 1: Local Ollama (default, slow on CPU) ---
CHAT_MODEL=qwen2.5-coder:3b

# --- Option 2: 9router (recommended — uses your Kiro subscription) ---
# 9router routes to the best available model via your existing subscriptions.
# Make sure 9router is running first (run 9router.cmd).
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=http://localhost:20128/v1
# CHAT_MODEL=kiro-fallback

# --- Option 3: Gemini via Antigravity / Google One ---
# Get API key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key
# CHAT_MODEL=gemini-2.0-flash

# --- Option 4: Groq (free tier, fast) ---
# Get API key from https://console.groq.com
# GROQ_API_KEY=your-groq-api-key
# CHAT_MODEL=llama-3.1-8b-instant

# --- Option 5: OpenAI ---
# OPENAI_API_KEY=your-openai-api-key
# CHAT_MODEL=gpt-4o-mini

# --- Option 6: Any OpenAI-compatible provider ---
# OPENAI_API_KEY=your-api-key
# OPENAI_BASE_URL=https://your-provider.com/v1
# CHAT_MODEL=your-model-name

# --- Option 7: Anthropic direct ---
# ANTHROPIC_API_KEY=your-anthropic-api-key
# CHAT_MODEL=claude-opus-4-8
