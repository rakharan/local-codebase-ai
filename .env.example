# Local Codebase AI — Environment Configuration
# Copy this file to .env and fill in the values.

# --- Qdrant (vector database) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=code_chunks

# --- Ollama (local embeddings — always required) ---
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
VECTOR_SIZE=768

# --- Chat model ---
# Default: local Ollama (slow on CPU)
CHAT_MODEL=qwen2.5-coder:3b

# For Gemini (fast, recommended for demo):
#   1. Get API key from https://aistudio.google.com/apikey
#   2. Set GEMINI_API_KEY and change CHAT_MODEL:
# GEMINI_API_KEY=your-gemini-api-key
# CHAT_MODEL=gemini-2.0-flash

# For Groq (fast, free tier):
#   1. Get API key from https://console.groq.com
#   2. Set GROQ_API_KEY and change CHAT_MODEL:
# GROQ_API_KEY=your-groq-api-key
# CHAT_MODEL=llama-3.1-8b-instant

# For OpenAI:
# OPENAI_API_KEY=your-openai-api-key
# CHAT_MODEL=gpt-4o-mini

# For any other OpenAI-compatible provider:
# OPENAI_API_KEY=your-api-key
# OPENAI_BASE_URL=https://your-provider.com/v1
# CHAT_MODEL=your-model-name

# --- Ollama context window (only used when running local Ollama) ---
# Lower = faster on CPU. Default 8192 is a good balance.
OLLAMA_NUM_CTX=8192
